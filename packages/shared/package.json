{
  "name": "@mony/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Código compartilhado entre app, API e admin: dinheiro, datas, enums e catálogo de erros",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./autenticacao": {
      "types": "./dist/autenticacao.d.ts",
      "default": "./dist/autenticacao.js"
    },
    "./categorias": {
      "types": "./dist/categorias.d.ts",
      "default": "./dist/categorias.js"
    },
    "./config-app": {
      "types": "./dist/config-app.d.ts",
      "default": "./dist/config-app.js"
    },
    "./dinheiro": {
      "types": "./dist/dinheiro.d.ts",
      "default": "./dist/dinheiro.js"
    },
    "./datas": {
      "types": "./dist/datas.d.ts",
      "default": "./dist/datas.js"
    },
    "./enums": {
      "types": "./dist/enums.d.ts",
      "default": "./dist/enums.js"
    },
    "./erros": {
      "types": "./dist/erros.d.ts",
      "default": "./dist/erros.js"
    },
    "./nfce": {
      "types": "./dist/nfce.d.ts",
      "default": "./dist/nfce.js"
    },
    "./usuario": {
      "types": "./dist/usuario.d.ts",
      "default": "./dist/usuario.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mony/config": "workspace:*",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
