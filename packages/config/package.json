{
  "name": "@mony/config",
  "version": "0.0.0",
  "private": true,
  "description": "Configurações compartilhadas do monorepo: ESLint, Prettier, tsconfig e commitlint",
  "type": "module",
  "exports": {
    "./eslint": "./eslint.js",
    "./prettier": "./prettier.js",
    "./commitlint": "./commitlint.js",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/node.json": "./tsconfig/node.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.1"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": ">=6.0.0 <6.1.0"
  },
  "devDependencies": {
    "@commitlint/lint": "^21.2.3",
    "@commitlint/load": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
