  "info": {
    "title": "API do Mony",
    "description": "API do app Monitorizze e da assistente Mony.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "SaudeDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "CadastroDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "telefone": {
            "type": "string",
            "maxLength": 30
          },
          "senha": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "aceites": {
            "type": "object",
            "properties": {
              "termos": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "privacidade": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "required": [
              "termos",
              "privacidade"
            ]
          },
          "dispositivo": {
            "type": "object",
            "properties": {
              "identificador": {
                "type": "string",
                "minLength": 8,
                "maxLength": 200
              },
              "plataforma": {
                "type": "string",
                "enum": [
                  "ios",
                  "android"
                ]
              },
              "modelo": {
                "type": "string",
                "maxLength": 100
              }
            },
            "required": [
              "identificador",
              "plataforma"
            ]
          }
        },
        "required": [
          "nome",
          "email",
          "telefone",
          "senha",
          "aceites",
          "dispositivo"
        ]
      },
      "SessaoDto": {
        "type": "object",
        "properties": {
          "usuario": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "nome": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "telefone": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "onboardingConcluido": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "nome",
              "email",
              "telefone",
              "onboardingConcluido"
            ]
          },
          "tokens": {
            "type": "object",
            "properties": {
              "acesso": {
                "type": "string"
              },
              "acessoExpiraEm": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "renovacao": {
                "type": "string"
              },
              "renovacaoExpiraEm": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              }
            },
            "required": [
              "acesso",
              "acessoExpiraEm",
              "renovacao",
              "renovacaoExpiraEm"
            ]
          },
          "aceitesPendentes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "termos",
                "privacidade"
              ]
            }
          }
        },
        "required": [
          "usuario",
          "tokens",
          "aceitesPendentes"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "senha": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "dispositivo": {
            "type": "object",
            "properties": {
              "identificador": {
                "type": "string",
                "minLength": 8,
                "maxLength": 200
              },
              "plataforma": {
                "type": "string",
                "enum": [
                  "ios",
                  "android"
                ]
              },
              "modelo": {
                "type": "string",
                "maxLength": 100
              }
            },
            "required": [
              "identificador",
              "plataforma"
            ]
          }
        },
        "required": [
          "email",
          "senha",
          "dispositivo"
        ]
      },
      "RenovacaoDto": {
        "type": "object",
        "properties": {
          "renovacao": {
            "type": "string",
            "minLength": 20,
            "maxLength": 200
          }
        },
        "required": [
          "renovacao"
        ]
      },
      "PedidoCodigoDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          }
        },
        "required": [
          "email"
        ]
      },
      "ConferenciaCodigoDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "codigo": {
            "type": "string",
            "pattern": "^\\d{6}$"
          }
        },
        "required": [
          "email",
          "codigo"
        ]
      },
      "RedefinicaoSenhaDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "codigo": {
            "type": "string",
            "pattern": "^\\d{6}$"
          },
          "senha": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "dispositivo": {
            "type": "object",
            "properties": {
              "identificador": {
                "type": "string",
                "minLength": 8,
                "maxLength": 200
              },
              "plataforma": {
                "type": "string",
                "enum": [
                  "ios",
                  "android"
                ]
              },
              "modelo": {
                "type": "string",
                "maxLength": 100
              }
            },
            "required": [
              "identificador",
              "plataforma"
            ]
          }
        },
        "required": [
          "email",
          "codigo",
          "senha",
          "dispositivo"
        ]
      },
      "PerfilDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "telefone": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "telefoneVerificado": {
            "type": "boolean"
          },
          "fotoUrl": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fusoHorario": {
            "type": "string"
          },
          "onboardingConcluido": {
            "type": "boolean"
          },
          "temSenha": {
            "type": "boolean"
          },
          "loginsSociais": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "google",
                "apple"
              ]
            }
          },
          "criadoEm": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "nome",
          "email",
          "telefone",
          "telefoneVerificado",
          "fotoUrl",
          "fusoHorario",
          "onboardingConcluido",
          "temSenha",
          "loginsSociais",
          "criadoEm"
        ]
      },
      "AtualizacaoPerfilDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "telefone": {
            "type": "string",
            "maxLength": 30
          },
          "fusoHorario": {
            "type": "string",
            "maxLength": 64
          }
        }
      },
      "RegistroDispositivoDto": {
        "type": "object",
        "properties": {
          "tokenPush": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 10,
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "modelo": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "tokenPush"
        ]
      },
      "OnboardingDto": {
        "type": "object",
        "properties": {
          "concluido": {
            "type": "boolean"
          },
          "etapas": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "etapa": {
                  "type": "string",
                  "enum": [
                    "primeiro-lancamento",
                    "cartoes",
                    "orcamento",
                    "permissoes",
                    "tour"
                  ]
                },
                "situacao": {
                  "type": "string",
                  "enum": [
                    "pendente",
                    "concluida",
                    "dispensada"
                  ]
                },
                "em": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "etapa",
                "situacao",
                "em"
              ]
            }
          },
          "checklistVisivel": {
            "type": "boolean"
          },
          "dicasVistas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "concluido",
          "etapas",
          "checklistVisivel",
          "dicasVistas"
        ]
      },
      "AtualizacaoOnboardingDto": {
        "type": "object",
        "properties": {
