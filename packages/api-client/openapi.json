              "schema": {
                "$ref": "#/components/schemas/PedidoCodigoDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Se existe conta ativa com o e-mail, o código foi enviado. A resposta é a mesma nos dois casos."
          }
        },
        "tags": [
          "autenticacao"
        ]
      }
    },
    "/v1/auth/senha/conferir": {
      "post": {
        "operationId": "conferirCodigoSenhaAutenticacao",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConferenciaCodigoDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Código certo e ainda válido; ele não é gasto aqui."
          }
        },
        "tags": [
          "autenticacao"
        ]
      }
    },
    "/v1/auth/senha/redefinir": {
      "post": {
        "operationId": "redefinirSenhaAutenticacao",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RedefinicaoSenhaDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Senha trocada, sessões dos outros aparelhos encerradas e sessão aberta neste.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessaoDto"
                }
              }
            }
          }
        },
        "tags": [
          "autenticacao"
        ]
      }
    },
    "/v1/auth/sair-todos": {
