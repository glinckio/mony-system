      },
      "patch": {
        "operationId": "atualizarPerfilUsuarios",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AtualizacaoPerfilDto"
