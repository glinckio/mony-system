            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistroDispositivoDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Token de push gravado no aparelho desta sessão."
          }
        },
        "security": [
          {
            "bearer": []
