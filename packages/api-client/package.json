{
  "name": "@mony/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Cliente HTTP e hooks TanStack Query gerados pelo Orval a partir do OpenAPI da API (não editar src/gerado à mão)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "pnpm --filter api run openapi:exportar ../../packages/api-client/openapi.json && orval --config ./orval.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mony/shared": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@mony/config": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "@types/react": "^19.3.0",
    "eslint": "^10.12.0",
    "orval": "^8.40.0",
    "react": "^19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
