{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "API do Mony (NestJS + Fastify), com dois entrypoints: HTTP (main) e worker",
  "scripts": {
    "generate": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prisma": "prisma",
    "seed": "prisma db seed",
    "openapi:exportar": "pnpm run generate && pnpm run build && node dist/exportar-openapi.js",
    "mony:avaliar": "node dist/avaliar-mony.js",
    "cobranca:configurar": "node dist/configurar-stripe.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@fastify/static": "^10.1.5",
    "@mony/shared": "workspace:*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/websockets": "^11.2.7",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^6.3.11",
    "fastify": "5.11.3",
    "fflate": "0.8.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.0.16",
    "pdfkit": "0.17.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "~7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "4.8.3",
    "stripe": "23.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mony/config": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@swc/core": "^1.16.13",
    "@types/node": "^24.19.1",
    "@types/pdfkit": "0.17.3",
    "eslint": "^10.12.0",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
