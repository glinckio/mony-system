/// Idempotência e reprocessamento de webhooks Stripe e Open Finance.
model WebhookEvento {
  id           String          @id @default(uuid(7)) @db.Uuid
  provedor     ProvedorWebhook
  idExterno    String          @map("id_externo")
  tipo         String
  payload      Json
  processadoEm DateTime?       @map("processado_em") @db.Timestamptz(6)
  erro         String?
  criadoEm     DateTime        @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime        @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@unique([provedor, idExterno])
  @@map("webhook_eventos")
}

/// LGPD: versão e data do aceite dos termos (RN-007).
model AceiteTermos {
  id           String          @id @default(uuid(7)) @db.Uuid
  usuarioId    String          @map("usuario_id") @db.Uuid
  documento    DocumentoAceite
  versao       String
  aceitoEm     DateTime        @default(now()) @map("aceito_em") @db.Timestamptz(6)
  ip           String?
  criadoEm     DateTime        @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime        @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, documento])
  @@map("aceites_termos")
}

/// LGPD: consentimento separado e revogável por finalidade.
model Consentimento {
  id           String                  @id @default(uuid(7)) @db.Uuid
  usuarioId    String                  @map("usuario_id") @db.Uuid
  finalidade   FinalidadeConsentimento
  concedidoEm  DateTime                @default(now()) @map("concedido_em") @db.Timestamptz(6)
  revogadoEm   DateTime?               @map("revogado_em") @db.Timestamptz(6)
  criadoEm     DateTime                @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime                @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, finalidade])
  @@map("consentimentos")
}

/// Um teste grátis por pessoa (RN-125). Sem usuario_id: sobrevive à exclusão da conta.
model ControleTeste {
  id           String            @id @default(uuid(7)) @db.Uuid
  tipo         TipoControleTeste
  valorHash    String            @map("valor_hash")
  usadoEm      DateTime          @default(now()) @map("usado_em") @db.Timestamptz(6)
  criadoEm     DateTime          @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime          @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@unique([tipo, valorHash])
  @@map("controle_teste")
}

/// Cupons do admin espelhando a Stripe (RN-130).
model Cupom {
  id             String    @id @default(uuid(7)) @db.Uuid
  codigo         String    @unique
  stripeCouponId String    @unique @map("stripe_coupon_id")
  percentual     Int       @db.SmallInt
  validade       DateTime? @db.Timestamptz(6)
  ativo          Boolean   @default(true)
  criadoPorId    String?   @map("criado_por") @db.Uuid
  criadoEm       DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  criadoPor Usuario? @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@index([criadoPorId])
  @@map("cupons")
}

/// Prompt versionado da Mony, editável sem nova versão do app (doc 08).
