  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, chave])
  @@map("dicas_vistas")
}

/// Fatura em PDF ou foto com vários lançamentos aguardando confirmação (RN-083).
model ImportacaoDocumento {
  id           String           @id @default(uuid(7)) @db.Uuid
  usuarioId    String           @map("usuario_id") @db.Uuid
  arquivoId    String           @map("arquivo_id") @db.Uuid
  tipo         TipoImportacao
  status       StatusImportacao @default(processando)
  resultado    Json?
  criadoEm     DateTime         @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  arquivo Anexo   @relation(fields: [arquivoId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([arquivoId])
  @@map("importacoes_documento")
}
