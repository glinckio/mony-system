// ─── Conta e assinatura (9) ─────────────────────────────────────────────────────────────────────

model Usuario {
  id                   String        @id @default(uuid(7)) @db.Uuid
  nome                 String
  /// Único e sempre em minúsculas (RN-001); a normalização é feita na aplicação.
  email                String        @unique
  telefone             String?
  /// Nulo para quem só entra por login social.
  senhaHash            String?       @map("senha_hash")
  fotoUrl              String?       @map("foto_url")
  papel                PapelUsuario  @default(usuario)
  status               StatusUsuario @default(ativo)
  onboardingConcluido  Boolean       @default(false) @map("onboarding_concluido")
  ultimoAcesso         DateTime?     @map("ultimo_acesso") @db.Timestamptz(6)
  /// ADR-008: dia, mês, silêncio e rotinas no fuso do usuário.
  fusoHorario          String        @default("America/Sao_Paulo") @map("fuso_horario")
  /// Ligação de voz só para número verificado (RN-078).
  telefoneVerificadoEm DateTime?     @map("telefone_verificado_em") @db.Timestamptz(6)
  criadoEm             DateTime      @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm         DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  loginsSociais          LoginSocial[]
  dispositivos           Dispositivo[]
  sessoes                Sessao[]
  codigosRecuperacao     CodigoRecuperacao[]
  assinatura             Assinatura?
  precosAlterados        PlanoPreco[]
  usoRecursos            UsoRecurso[]
  categorias             Categoria[]
  contas                 Conta[]
  cartoes                Cartao[]
  faturas                Fatura[]
  transacoes             Transacao[]
  recorrencias           Recorrencia[]
  parcelamentos          Parcelamento[]
  parcelas               Parcela[]
  anexos                 Anexo[]
  nfceNotas              NfceNota[]
  nfceItens              NfceItem[]
  orcamentos             Orcamento[]
  metas                  Meta[]
  metasAportes           MetaAporte[]
  listasCompras          ListaCompras[]
  itensLista             ItemLista[]
  compartilhamentos      Compartilhamento[]     @relation("CompartilhamentoDono")
  convitesRecebidos      Compartilhamento[]     @relation("CompartilhamentoConvidado")
  lembretes              Lembrete[]
  agendasConectadas      AgendaConectada[]
  compromissos           Compromisso[]
  notificacoes           Notificacao[]
  preferenciasAlerta     PreferenciaAlerta[]
  appsMonitorados        AppMonitorado[]
  conexoesOpenFinance    ConexaoOpenFinance[]
  conversas              Conversa[]
  mensagens              Mensagem[]
  rascunhos              RascunhoLancamento[]
  preferenciasAprendidas PreferenciaAprendida[]
  logsIa                 LogIa[]
  novidadesAutoradas     Novidade[]
  novidadesLidas         NovidadeLeitura[]
  registrosAuditoria     RegistroAuditoria[]
  aceitesTermos          AceiteTermos[]
  consentimentos         Consentimento[]
  cuponsCriados          Cupom[]
  monyConfigsCriadas     MonyConfig[]
  ligacoes               Ligacao[]
  dicasVistas            DicaVista[]
  importacoesDocumento   ImportacaoDocumento[]

  @@map("usuarios")
}

model LoginSocial {
  id           String              @id @default(uuid(7)) @db.Uuid
  usuarioId    String              @map("usuario_id") @db.Uuid
  provedor     ProvedorLoginSocial
  idExterno    String              @map("id_externo")
  criadoEm     DateTime            @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime            @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([provedor, idExterno])
  @@index([usuarioId])
  @@map("logins_sociais")
}

model Dispositivo {
  id                    String                @id @default(uuid(7)) @db.Uuid
  usuarioId             String                @map("usuario_id") @db.Uuid
  plataforma            PlataformaDispositivo
  tokenPush             String?               @map("token_push")
  identificadorAparelho String                @map("identificador_aparelho")
  modelo                String?
  ultimoUso             DateTime?             @map("ultimo_uso") @db.Timestamptz(6)
  /// Token inválido nos recibos do push desativa o dispositivo (doc 09).
  ativo                 Boolean               @default(true)
  criadoEm              DateTime              @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm          DateTime              @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sessoes Sessao[]

  @@unique([usuarioId, identificadorAparelho])
  @@index([usuarioId])
  @@map("dispositivos")
}

model Sessao {
  id               String    @id @default(uuid(7)) @db.Uuid
  usuarioId        String    @map("usuario_id") @db.Uuid
  dispositivoId    String?   @map("dispositivo_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiraEm         DateTime  @map("expira_em") @db.Timestamptz(6)
  revogadaEm       DateTime? @map("revogada_em") @db.Timestamptz(6)
  criadoEm         DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm     DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario     Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  dispositivo Dispositivo? @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([dispositivoId])
  @@map("sessoes")
}

model CodigoRecuperacao {
  id           String   @id @default(uuid(7)) @db.Uuid
  usuarioId    String   @map("usuario_id") @db.Uuid
  codigoHash   String   @map("codigo_hash")
  expiraEm     DateTime @map("expira_em") @db.Timestamptz(6)
  usado        Boolean  @default(false)
  /// Máximo de 5 tentativas por código (RN-003).
  tentativas   Int      @default(0)
  ip           String?
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("codigos_recuperacao")
}

/// Uma assinatura por usuário; o plano atual e o estado da cobrança.
model Assinatura {
  id                   String           @id @default(uuid(7)) @db.Uuid
  usuarioId            String           @unique @map("usuario_id") @db.Uuid
  plano                Plano
  status               StatusAssinatura @default(ativa)
  planoPrecoId         String?          @map("plano_preco_id") @db.Uuid
  testeInicio          DateTime?        @map("teste_inicio") @db.Timestamptz(6)
  testeFim             DateTime?        @map("teste_fim") @db.Timestamptz(6)
  stripeCustomerId     String?          @unique @map("stripe_customer_id")
  stripeSubscriptionId String?          @unique @map("stripe_subscription_id")
  inicio               DateTime?        @db.Timestamptz(6)
  proximaCobranca      DateTime?        @map("proxima_cobranca") @db.Timestamptz(6)
  cancelamentoAgendado Boolean          @default(false) @map("cancelamento_agendado")
  canceladaEm          DateTime?        @map("cancelada_em") @db.Timestamptz(6)
  criadoEm             DateTime         @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm         DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario    Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  planoPreco PlanoPreco? @relation(fields: [planoPrecoId], references: [id], onDelete: SetNull)

  @@index([planoPrecoId])
  @@map("assinaturas")
}

/// Histórico de preços (RN-129): novo preço cria nova linha e um novo Price na Stripe.
model PlanoPreco {
  id            String    @id @default(uuid(7)) @db.Uuid
  plano         PlanoPago
  valor         BigInt
  stripePriceId String    @unique @map("stripe_price_id")
  vigente       Boolean   @default(false)
  vigenteDesde  DateTime  @map("vigente_desde") @db.Timestamptz(6)
  alteradoPorId String?   @map("alterado_por") @db.Uuid
  criadoEm      DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  alteradoPor Usuario?     @relation(fields: [alteradoPorId], references: [id], onDelete: SetNull)
  assinaturas Assinatura[]

  @@index([plano, vigente])
  @@index([alteradoPorId])
  @@map("planos_precos")
}

/// Limites do plano gratuito (RN-120), editáveis no admin.
model LimitePlano {
  id               String       @id @default(uuid(7)) @db.Uuid
  recurso          RecursoPlano @unique
  limiteDia        Int?         @map("limite_dia")
  limiteMes        Int?         @map("limite_mes")
  /// Limites de quantidade (cartão, lista, lembrete ativo) contam itens existentes (RN-120).
  limiteQuantidade Int?         @map("limite_quantidade")
  criadoEm         DateTime     @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm     DateTime     @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@map("limites_plano")
}

/// Contagem de uso por dia no fuso do usuário (RN-122).
model UsoRecurso {
  id           String       @id @default(uuid(7)) @db.Uuid
  usuarioId    String       @map("usuario_id") @db.Uuid
  recurso      RecursoPlano
  data         DateTime     @db.Date
  quantidade   Int          @default(0)
  criadoEm     DateTime     @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime     @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, recurso, data])
  @@map("uso_recursos")
}

// ─── Finanças (11) ──────────────────────────────────────────────────────────────────────────────

model Categoria {
  id           String        @id @default(uuid(7)) @db.Uuid
  usuarioId    String        @map("usuario_id") @db.Uuid
  nome         String
  tipo         TipoCategoria
  cor          String
  icone        String
  /// Criada no cadastro a partir da lista padrão (RN-065).
  padrao       Boolean       @default(false)
  excluidoEm   DateTime?     @map("excluido_em") @db.Timestamptz(6)
  criadoEm     DateTime      @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario                Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  transacoes             Transacao[]
  recorrencias           Recorrencia[]
  parcelamentos          Parcelamento[]
  orcamentos             Orcamento[]
  preferenciasAprendidas PreferenciaAprendida[]

  @@index([usuarioId, tipo])
  @@map("categorias")
}

model Conta {
  id                   String      @id @default(uuid(7)) @db.Uuid
  usuarioId            String      @map("usuario_id") @db.Uuid
  nome                 String
  tipo                 TipoConta
  saldoInicial         BigInt      @default(0) @map("saldo_inicial")
  origem               OrigemConta @default(manual)
  idExterno            String?     @map("id_externo")
  conexaoOpenFinanceId String?     @map("conexao_open_finance_id") @db.Uuid
  criadoEm             DateTime    @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm         DateTime    @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario            Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  conexaoOpenFinance ConexaoOpenFinance? @relation(fields: [conexaoOpenFinanceId], references: [id], onDelete: SetNull)
  transacoes         Transacao[]
  recorrencias       Recorrencia[]
  cartoesPagos       Cartao[]            @relation("CartaoContaPagamento")

  @@unique([usuarioId, idExterno])
  @@index([conexaoOpenFinanceId])
  @@map("contas")
}

model Cartao {
  id                   String      @id @default(uuid(7)) @db.Uuid
  usuarioId            String      @map("usuario_id") @db.Uuid
  nome                 String
  bandeira             String?
  /// Últimos 4 dígitos (opcional, RN-030).
  final                String?     @db.VarChar(4)
  limiteTotal          BigInt      @map("limite_total")
  /// 1 a 31; dia maior que o mês usa o último dia (RN-032).
  diaFechamento        Int         @map("dia_fechamento") @db.SmallInt
  diaVencimento        Int         @map("dia_vencimento") @db.SmallInt
  cor                  String
  /// Faixas de alerta de limite em % (RN-038).
  faixasAlerta         Int[]       @default([50, 80, 100]) @map("faixas_alerta")
  origem               OrigemConta @default(manual)
  idExterno            String?     @map("id_externo")
  conexaoOpenFinanceId String?     @map("conexao_open_finance_id") @db.Uuid
  /// Conta padrão de onde sai o pagamento da fatura.
  contaPagamentoId     String?     @map("conta_pagamento_id") @db.Uuid
  excluidoEm           DateTime?   @map("excluido_em") @db.Timestamptz(6)
  criadoEm             DateTime    @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm         DateTime    @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario                Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  conexaoOpenFinance     ConexaoOpenFinance?    @relation(fields: [conexaoOpenFinanceId], references: [id], onDelete: SetNull)
  contaPagamento         Conta?                 @relation("CartaoContaPagamento", fields: [contaPagamentoId], references: [id], onDelete: SetNull)
  faturas                Fatura[]
  transacoes             Transacao[]
  recorrencias           Recorrencia[]
  parcelamentos          Parcelamento[]
  preferenciasAprendidas PreferenciaAprendida[]

  @@unique([usuarioId, idExterno])
  @@index([conexaoOpenFinanceId])
  @@index([contaPagamentoId])
  @@map("cartoes")
}

model Fatura {
  id             String       @id @default(uuid(7)) @db.Uuid
  usuarioId      String       @map("usuario_id") @db.Uuid
  cartaoId       String       @map("cartao_id") @db.Uuid
  /// Mês do vencimento, `YYYY-MM-01` (RN-031).
  competencia    DateTime     @db.Date
  dataFechamento DateTime     @map("data_fechamento") @db.Date
  dataVencimento DateTime     @map("data_vencimento") @db.Date
  valorTotal     BigInt       @default(0) @map("valor_total")
  valorPago      BigInt       @default(0) @map("valor_pago")
  status         StatusFatura @default(aberta)
  criadoEm       DateTime     @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime     @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario    Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cartao     Cartao      @relation(fields: [cartaoId], references: [id], onDelete: Cascade)
  transacoes Transacao[]
  parcelas   Parcela[]

  @@unique([cartaoId, competencia])
  @@index([usuarioId])
  @@index([dataVencimento, status])
  @@map("faturas")
}

model Transacao {
  id                 String            @id @default(uuid(7)) @db.Uuid
  usuarioId          String            @map("usuario_id") @db.Uuid
  tipo               TipoTransacao
  descricao          String
  valor              BigInt
  data               DateTime          @db.Date
  status             StatusTransacao
  formaPagamento     FormaPagamento?   @map("forma_pagamento")
  origem             OrigemTransacao   @default(manual)
  /// `pagamento_fatura` não entra em totais de despesa (RN-037).
  natureza           NaturezaTransacao @default(normal)
  observacao         String?
  categoriaId        String            @map("categoria_id") @db.Uuid
  contaId            String?           @map("conta_id") @db.Uuid
  cartaoId           String?           @map("cartao_id") @db.Uuid
  faturaId           String?           @map("fatura_id") @db.Uuid
  recorrenciaId      String?           @map("recorrencia_id") @db.Uuid
  parcelamentoId     String?           @map("parcelamento_id") @db.Uuid
  parcelaId          String?           @unique @map("parcela_id") @db.Uuid
  nfceNotaId         String?           @unique @map("nfce_nota_id") @db.Uuid
  /// Identificador no agregador de Open Finance; reimportação nunca duplica (RN-140).
  idExterno          String?           @map("id_externo")
  /// União manual × Open Finance (RN-142).
  transacaoUnidaId   String?           @map("transacao_unida_id") @db.Uuid
  /// Estabelecimento normalizado: base das preferências aprendidas e do "fora do padrão".
  estabelecimento    String?
  /// Recorrência não sobrescreve ocorrência editada à mão (RN-043).
  editadaManualmente Boolean           @default(false) @map("editada_manualmente")
  excluidoEm         DateTime?         @map("excluido_em") @db.Timestamptz(6)
  criadoEm           DateTime          @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm       DateTime          @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario        Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  categoria      Categoria     @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  conta          Conta?        @relation(fields: [contaId], references: [id], onDelete: SetNull)
  cartao         Cartao?       @relation(fields: [cartaoId], references: [id], onDelete: Restrict)
  fatura         Fatura?       @relation(fields: [faturaId], references: [id], onDelete: Restrict)
  recorrencia    Recorrencia?  @relation(fields: [recorrenciaId], references: [id], onDelete: SetNull)
  parcelamento   Parcelamento? @relation(fields: [parcelamentoId], references: [id], onDelete: Restrict)
  parcela        Parcela?      @relation("TransacaoParcela", fields: [parcelaId], references: [id], onDelete: SetNull)
  nfceNota       NfceNota?     @relation("TransacaoNfceNota", fields: [nfceNotaId], references: [id], onDelete: SetNull)
  transacaoUnida Transacao?    @relation("TransacaoUnida", fields: [transacaoUnidaId], references: [id], onDelete: SetNull)
  unidaPor       Transacao[]   @relation("TransacaoUnida")
  anexos         Anexo[]
  parcelaOrigem  Parcela?      @relation("ParcelaTransacao")
  nfceOrigem     NfceNota?     @relation("NfceNotaTransacao")
  itensLista     ItemLista[]

  @@unique([usuarioId, idExterno])
  @@index([usuarioId, data(sort: Desc)])
  @@index([usuarioId, categoriaId, data])
  @@index([faturaId])
  @@index([categoriaId])
  @@index([contaId])
  @@index([cartaoId])
  @@index([recorrenciaId])
  @@index([parcelamentoId])
  @@index([transacaoUnidaId])
  @@map("transacoes")
}

/// Modelo da recorrência; a rotina diária materializa as ocorrências dos próximos 35 dias (RN-043).
model Recorrencia {
  id             String                @id @default(uuid(7)) @db.Uuid
  usuarioId      String                @map("usuario_id") @db.Uuid
  categoriaId    String                @map("categoria_id") @db.Uuid
  tipo           TipoTransacao
  descricao      String
  valor          BigInt
  formaPagamento FormaPagamento?       @map("forma_pagamento")
  contaId        String?               @map("conta_id") @db.Uuid
  cartaoId       String?               @map("cartao_id") @db.Uuid
  frequencia     FrequenciaRecorrencia
  /// Dia do mês (mensal/anual) ou da semana (semanal); 29 a 31 em mês curto vira o último dia.
  dia            Int?                  @db.SmallInt
  dataInicio     DateTime              @map("data_inicio") @db.Date
  /// Nulo = indeterminada.
  dataFim        DateTime?             @map("data_fim") @db.Date
  proximaGeracao DateTime              @map("proxima_geracao") @db.Date
  ativa          Boolean               @default(true)
  criadoEm       DateTime              @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime              @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario    Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  categoria  Categoria   @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  conta      Conta?      @relation(fields: [contaId], references: [id], onDelete: SetNull)
  cartao     Cartao?     @relation(fields: [cartaoId], references: [id], onDelete: SetNull)
  transacoes Transacao[]

  @@index([usuarioId])
  @@index([proximaGeracao, ativa])
  @@index([categoriaId])
  @@index([contaId])
  @@index([cartaoId])
  @@map("recorrencias")
}

model Parcelamento {
  id              String             @id @default(uuid(7)) @db.Uuid
  usuarioId       String             @map("usuario_id") @db.Uuid
  nome            String
  tipo            TipoParcelamento
  /// Com juros, é a soma das parcelas; o valor financiado fica em `valor_financiado` (RN-052).
  valorTotal      BigInt             @map("valor_total")
  valorFinanciado BigInt?            @map("valor_financiado")
  totalParcelas   Int                @map("total_parcelas") @db.SmallInt
  /// Fração mensal: 0.029900 = 2,99% a.m.
  taxaJuros       Decimal?           @map("taxa_juros") @db.Decimal(9, 6)
  dataInicio      DateTime           @map("data_inicio") @db.Date
  status          StatusParcelamento @default(ativa)
  observacao      String?
  categoriaId     String             @map("categoria_id") @db.Uuid
  cartaoId        String?            @map("cartao_id") @db.Uuid
  excluidoEm      DateTime?          @map("excluido_em") @db.Timestamptz(6)
  criadoEm        DateTime           @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm    DateTime           @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario    Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  categoria  Categoria   @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  cartao     Cartao?     @relation(fields: [cartaoId], references: [id], onDelete: Restrict)
  parcelas   Parcela[]
  transacoes Transacao[]

  @@index([usuarioId])
  @@index([categoriaId])
  @@index([cartaoId])
  @@map("parcelamentos")
}

model Parcela {
  id             String        @id @default(uuid(7)) @db.Uuid
  usuarioId      String        @map("usuario_id") @db.Uuid
  parcelamentoId String        @map("parcelamento_id") @db.Uuid
  numero         Int           @db.SmallInt
  valor          BigInt
  vencimento     DateTime      @db.Date
  status         StatusParcela @default(pendente)
  pagoEm         DateTime?     @map("pago_em") @db.Timestamptz(6)
  /// Despesa pendente ligada à parcela (RN-051).
  transacaoId    String?       @unique @map("transacao_id") @db.Uuid
  /// Compra no cartão: fatura em que a parcela cai.
  faturaId       String?       @map("fatura_id") @db.Uuid
  criadoEm       DateTime      @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario         Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  parcelamento    Parcelamento @relation(fields: [parcelamentoId], references: [id], onDelete: Cascade)
  transacao       Transacao?   @relation("ParcelaTransacao", fields: [transacaoId], references: [id], onDelete: SetNull)
  fatura          Fatura?      @relation(fields: [faturaId], references: [id], onDelete: SetNull)
  transacaoDireta Transacao?   @relation("TransacaoParcela")

  @@unique([parcelamentoId, numero])
  @@index([usuarioId])
  @@index([vencimento, status])
  @@index([faturaId])
  @@map("parcelas")
}

model Anexo {
  id           String    @id @default(uuid(7)) @db.Uuid
  usuarioId    String    @map("usuario_id") @db.Uuid
  tipo         TipoAnexo
  /// Chave do objeto no S3 (inclui o usuarioId; leitura só por URL assinada).
  arquivoUrl   String    @map("arquivo_url")
  /// Tamanho em bytes.
  tamanho      Int
  transacaoId  String?   @map("transacao_id") @db.Uuid
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario     Usuario               @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  transacao   Transacao?            @relation(fields: [transacaoId], references: [id], onDelete: SetNull)
  mensagem    Mensagem?
  importacoes ImportacaoDocumento[]

  @@index([usuarioId])
  @@index([transacaoId])
  @@map("anexos")
}

model NfceNota {
  id           String   @id @default(uuid(7)) @db.Uuid
  usuarioId    String   @map("usuario_id") @db.Uuid
  chaveAcesso  String   @map("chave_acesso") @db.VarChar(44)
  emitente     String
  cnpj         String   @db.VarChar(14)
  /// Data e hora de emissão.
  data         DateTime @db.Timestamptz(6)
  total        BigInt
  uf           String   @db.Char(2)
  transacaoId  String?  @unique @map("transacao_id") @db.Uuid
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario         Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  transacao       Transacao? @relation("NfceNotaTransacao", fields: [transacaoId], references: [id], onDelete: SetNull)
  transacaoDireta Transacao? @relation("TransacaoNfceNota")
  itens           NfceItem[]

  @@unique([usuarioId, chaveAcesso])
  @@map("nfce_notas")
}

model NfceItem {
  id            String   @id @default(uuid(7)) @db.Uuid
  usuarioId     String   @map("usuario_id") @db.Uuid
  notaId        String   @map("nota_id") @db.Uuid
  descricao     String
  quantidade    Decimal  @db.Decimal(12, 4)
  unidade       String
  valorUnitario BigInt   @map("valor_unitario")
  valorTotal    BigInt   @map("valor_total")
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nota    NfceNota @relation(fields: [notaId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([notaId])
  @@map("nfce_itens")
}

// ─── Planejamento (6) ───────────────────────────────────────────────────────────────────────────

model Orcamento {
  id            String   @id @default(uuid(7)) @db.Uuid
  usuarioId     String   @map("usuario_id") @db.Uuid
  categoriaId   String   @map("categoria_id") @db.Uuid
  competencia   DateTime @db.Date
