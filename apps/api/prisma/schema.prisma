// ─── Mony (5) ───────────────────────────────────────────────────────────────────────────────────

model Conversa {
  id               String    @id @default(uuid(7)) @db.Uuid
  usuarioId        String    @map("usuario_id") @db.Uuid
  iniciadaEm       DateTime  @default(now()) @map("iniciada_em") @db.Timestamptz(6)
  ultimaMensagemEm DateTime? @map("ultima_mensagem_em") @db.Timestamptz(6)
  criadoEm         DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm     DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario   Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  mensagens Mensagem[]
  rascunho  RascunhoLancamento?

  @@index([usuarioId])
  @@map("conversas")
}

model Mensagem {
  id             String        @id @default(uuid(7)) @db.Uuid
  usuarioId      String        @map("usuario_id") @db.Uuid
  conversaId     String        @map("conversa_id") @db.Uuid
  autor          AutorMensagem
  tipo           TipoMensagem
  conteudo       String?
  /// Botões, cartões de resumo e outros componentes da interface do chat.
  componentes    Json?
  anexoId        String?       @unique @map("anexo_id") @db.Uuid
  /// Rascunho que a mensagem completa.
  rascunhoId     String?       @map("rascunho_id") @db.Uuid
  /// Evita duplicar mensagem em reenvio.
  idempotencyKey String?       @map("idempotency_key")
  criadoEm       DateTime      @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario  Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  conversa Conversa            @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  anexo    Anexo?              @relation(fields: [anexoId], references: [id], onDelete: SetNull)
  rascunho RascunhoLancamento? @relation(fields: [rascunhoId], references: [id], onDelete: SetNull)
  logsIa   LogIa[]

  @@unique([conversaId, idempotencyKey])
  @@index([usuarioId])
  @@index([conversaId, criadoEm(sort: Desc)])
  @@index([rascunhoId])
  @@map("mensagens")
}

/// Lançamento em montagem no chat, válido por 24 h; um por conversa (RN-088).
model RascunhoLancamento {
  id            String   @id @default(uuid(7)) @db.Uuid
  usuarioId     String   @map("usuario_id") @db.Uuid
  conversaId    String   @unique @map("conversa_id") @db.Uuid
  dados         Json
  campoPendente String?  @map("campo_pendente")
  expiraEm      DateTime @map("expira_em") @db.Timestamptz(6)
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario   Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  conversa  Conversa   @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  mensagens Mensagem[]

  @@index([usuarioId])
  @@map("rascunhos_lancamento")
}

/// Estabelecimento → categoria, cartão e forma de pagamento mais usados (RN-090).
model PreferenciaAprendida {
  id             String          @id @default(uuid(7)) @db.Uuid
  usuarioId      String          @map("usuario_id") @db.Uuid
  chave          String
  categoriaId    String?         @map("categoria_id") @db.Uuid
  cartaoId       String?         @map("cartao_id") @db.Uuid
  formaPagamento FormaPagamento? @map("forma_pagamento")
  contagem       Int             @default(0)
  criadoEm       DateTime        @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime        @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario   Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  categoria Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  cartao    Cartao?    @relation(fields: [cartaoId], references: [id], onDelete: SetNull)

  @@unique([usuarioId, chave])
  @@index([categoriaId])
  @@index([cartaoId])
  @@map("preferencias_aprendidas")
}

model LogIa {
  id            String   @id @default(uuid(7)) @db.Uuid
  usuarioId     String   @map("usuario_id") @db.Uuid
  mensagemId    String?  @map("mensagem_id") @db.Uuid
  modelo        String
  tokensEntrada Int      @map("tokens_entrada")
  tokensSaida   Int      @map("tokens_saida")
  ferramenta    String?
  duracaoMs     Int      @map("duracao_ms")
  erro          String?
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario  Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  mensagem Mensagem? @relation(fields: [mensagemId], references: [id], onDelete: SetNull)

  @@index([usuarioId, criadoEm])
  @@index([mensagemId])
  @@map("logs_ia")
}

// ─── Administração (3) ──────────────────────────────────────────────────────────────────────────

model Novidade {
  id           String         @id @default(uuid(7)) @db.Uuid
  autorId      String?        @map("autor_id") @db.Uuid
  titulo       String
  descricao    String
  videoUrl     String?        @map("video_url")
  publicadaEm  DateTime?      @map("publicada_em") @db.Timestamptz(6)
  validade     DateTime?      @db.Timestamptz(6)
  status       StatusNovidade @default(rascunho)
  criadoEm     DateTime       @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime       @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  autor    Usuario?          @relation(fields: [autorId], references: [id], onDelete: SetNull)
  leituras NovidadeLeitura[]

  @@index([status, publicadaEm])
  @@index([autorId])
  @@map("novidades")
}

model NovidadeLeitura {
  id           String   @id @default(uuid(7)) @db.Uuid
  usuarioId    String   @map("usuario_id") @db.Uuid
  novidadeId   String   @map("novidade_id") @db.Uuid
  lidaEm       DateTime @default(now()) @map("lida_em") @db.Timestamptz(6)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  novidade Novidade @relation(fields: [novidadeId], references: [id], onDelete: Cascade)

  @@unique([novidadeId, usuarioId])
  @@index([usuarioId])
  @@map("novidades_leituras")
}

model RegistroAuditoria {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Quem fez a ação (admin ou o próprio usuário).
  usuarioId    String?  @map("usuario_id") @db.Uuid
  acao         String
  entidade     String
  entidadeId   String?  @map("entidade_id")
  antes        Json?
  depois       Json?
  ip           String?
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@index([entidade, entidadeId])
  @@map("auditoria")
}

