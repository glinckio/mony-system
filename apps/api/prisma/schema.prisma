  criadoPorId   String?  @map("criado_por") @db.Uuid
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  criadoPor Usuario? @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@index([criadoPorId])
  @@map("mony_config")
}

/// Custo e limite mensal de lembretes por ligação (RN-078).
model Ligacao {
  id            String   @id @default(uuid(7)) @db.Uuid
  usuarioId     String   @map("usuario_id") @db.Uuid
  lembreteId    String?  @map("lembrete_id") @db.Uuid
  /// Status devolvido pelo provedor de voz.
  status        String
  provedorId    String?  @unique @map("provedor_id")
  custoCentavos BigInt?  @map("custo_centavos")
  iniciadaEm    DateTime @map("iniciada_em") @db.Timestamptz(6)
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario  Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  lembrete Lembrete? @relation(fields: [lembreteId], references: [id], onDelete: SetNull)

  @@index([usuarioId, iniciadaEm])
  @@index([lembreteId])
  @@map("ligacoes")
}

/// Dicas contextuais e checklist de onboarding já vistos.
model DicaVista {
