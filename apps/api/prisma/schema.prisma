  repetirMensal Boolean  @default(false) @map("repetir_mensal")
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, categoriaId, competencia])
  @@index([categoriaId])
  @@map("orcamentos")
}

model Meta {
  id           String    @id @default(uuid(7)) @db.Uuid
  usuarioId    String    @map("usuario_id") @db.Uuid
  titulo       String
  valorAlvo    BigInt    @map("valor_alvo")
  /// Soma dos aportes (RN-063).
  valorAtual   BigInt    @default(0) @map("valor_atual")
  prazo        DateTime? @db.Date
  concluida    Boolean   @default(false)
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  aportes MetaAporte[]

  @@index([usuarioId])
  @@map("metas")
}

model MetaAporte {
  id           String   @id @default(uuid(7)) @db.Uuid
  usuarioId    String   @map("usuario_id") @db.Uuid
  metaId       String   @map("meta_id") @db.Uuid
  valor        BigInt
  data         DateTime @db.Date
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  meta    Meta    @relation(fields: [metaId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([metaId])
  @@map("metas_aportes")
}

model ListaCompras {
  id             String         @id @default(uuid(7)) @db.Uuid
  usuarioId      String         @map("usuario_id") @db.Uuid
  nome           String
  categoriaLista CategoriaLista @map("categoria_lista")
  finalizadaEm   DateTime?      @map("finalizada_em") @db.Timestamptz(6)
  criadoEm       DateTime       @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime       @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  itens   ItemLista[]

  @@index([usuarioId])
  @@map("listas_compras")
}

model ItemLista {
  id            String    @id @default(uuid(7)) @db.Uuid
  /// Dono da lista (o item pode ter sido adicionado por um convidado).
  usuarioId     String    @map("usuario_id") @db.Uuid
  listaId       String    @map("lista_id") @db.Uuid
  nome          String
  quantidade    Decimal   @default(1) @db.Decimal(12, 3)
  unidade       String?
  precoEstimado BigInt?   @map("preco_estimado")
  comprado      Boolean   @default(false)
  compradoEm    DateTime? @map("comprado_em") @db.Timestamptz(6)
  /// Despesa gerada ao finalizar a lista (RN-072).
  transacaoId   String?   @map("transacao_id") @db.Uuid
  criadoEm      DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario   Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  lista     ListaCompras @relation(fields: [listaId], references: [id], onDelete: Cascade)
  transacao Transacao?   @relation(fields: [transacaoId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@index([listaId])
  @@index([transacaoId])
  @@map("itens_lista")
}

/// Convite para lista ou lembrete (RN-074).
model Compartilhamento {
  id           String                    @id @default(uuid(7)) @db.Uuid
  /// Dono do recurso compartilhado.
  usuarioId    String                    @map("usuario_id") @db.Uuid
  recurso      RecursoCompartilhavel
  recursoId    String                    @map("recurso_id") @db.Uuid
  convidadoId  String                    @map("convidado_id") @db.Uuid
  permissao    PermissaoCompartilhamento
  status       StatusConvite             @default(pendente)
  criadoEm     DateTime                  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime                  @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario   Usuario @relation("CompartilhamentoDono", fields: [usuarioId], references: [id], onDelete: Cascade)
  convidado Usuario @relation("CompartilhamentoConvidado", fields: [convidadoId], references: [id], onDelete: Cascade)

  @@unique([recurso, recursoId, convidadoId])
  @@index([usuarioId])
  @@index([convidadoId])
  @@map("compartilhamentos")
}

// ─── Lembretes, agenda e alertas (6) ────────────────────────────────────────────────────────────

model Lembrete {
  id              String          @id @default(uuid(7)) @db.Uuid
  usuarioId       String          @map("usuario_id") @db.Uuid
  titulo          String
  dataHora        DateTime        @map("data_hora") @db.Timestamptz(6)
  /// Regra RRULE; nulo = lembrete único (RN-075).
  recorrencia     String?
  canais          CanalLembrete[]
  status          StatusLembrete  @default(ativo)
  adiadoAte       DateTime?       @map("adiado_ate") @db.Timestamptz(6)
  /// Controle do limite mensal de ligações (RN-078).
  ultimaLigacaoEm DateTime?       @map("ultima_ligacao_em") @db.Timestamptz(6)
  criadoEm        DateTime        @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm    DateTime        @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario  Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ligacoes Ligacao[]

  @@index([usuarioId])
  @@index([status, dataHora])
  @@map("lembretes")
}

model AgendaConectada {
  id             String         @id @default(uuid(7)) @db.Uuid
  usuarioId      String         @map("usuario_id") @db.Uuid
  provedor       ProvedorAgenda
  /// Tokens OAuth cifrados na aplicação (criptografia de envelope, doc 11).
  tokensCifrados String?        @map("tokens_cifrados")
  /// Agenda onde o app cria compromissos (RN-079).
  agendaPadrao   String?        @map("agenda_padrao")
  criadoEm       DateTime       @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime       @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario      Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  compromissos Compromisso[]

  @@index([usuarioId])
  @@map("agendas_conectadas")
}

model Compromisso {
  id           String            @id @default(uuid(7)) @db.Uuid
  usuarioId    String            @map("usuario_id") @db.Uuid
  agendaId     String?           @map("agenda_id") @db.Uuid
  titulo       String
  inicio       DateTime          @db.Timestamptz(6)
  fim          DateTime?         @db.Timestamptz(6)
  local        String?
  idExterno    String?           @map("id_externo")
  origem       OrigemCompromisso
  criadoEm     DateTime          @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime          @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  agenda  AgendaConectada? @relation(fields: [agendaId], references: [id], onDelete: Cascade)

  @@unique([agendaId, idExterno])
  @@index([usuarioId, inicio])
  @@map("compromissos")
}

/// Central de notificações; `chave_unica` impede alerta repetido (RN-102).
model Notificacao {
  id           String     @id @default(uuid(7)) @db.Uuid
  usuarioId    String     @map("usuario_id") @db.Uuid
  tipo         TipoAlerta
  titulo       String
  corpo        String
  /// Toda notificação abre a tela relacionada (RN-105).
  linkInterno  String     @map("link_interno")
  enviadaEm    DateTime?  @map("enviada_em") @db.Timestamptz(6)
  lidaEm       DateTime?  @map("lida_em") @db.Timestamptz(6)
  chaveUnica   String     @map("chave_unica")
  criadoEm     DateTime   @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime   @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, chaveUnica])
  @@index([usuarioId, criadoEm(sort: Desc)])
  @@map("notificacoes")
}

model PreferenciaAlerta {
  id               String     @id @default(uuid(7)) @db.Uuid
  usuarioId        String     @map("usuario_id") @db.Uuid
  tipoAlerta       TipoAlerta @map("tipo_alerta")
  ativo            Boolean    @default(true)
  antecedenciaDias Int?       @map("antecedencia_dias") @db.SmallInt
  /// Horário local `HH:MM` (RN-101).
  silencioInicio   String?    @map("silencio_inicio") @db.VarChar(5)
  silencioFim      String?    @map("silencio_fim") @db.VarChar(5)
  criadoEm         DateTime   @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm     DateTime   @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, tipoAlerta])
  @@map("preferencias_alerta")
}

model AppMonitorado {
  id               String    @id @default(uuid(7)) @db.Uuid
  usuarioId        String    @map("usuario_id") @db.Uuid
  /// Pacote no Android (ex.: `com.shopee.br`); no iOS o app escolhe pelo Screen Time.
  identificadorApp String    @map("identificador_app")
  nome             String
  ativo            Boolean   @default(true)
  ultimoAlerta     DateTime? @map("ultimo_alerta") @db.Timestamptz(6)
  criadoEm         DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm     DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, identificadorApp])
  @@map("apps_monitorados")
}

// ─── Open Finance (1) ───────────────────────────────────────────────────────────────────────────

model ConexaoOpenFinance {
