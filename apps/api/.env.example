# Copie para .env e ajuste. Valores de exemplo, só para desenvolvimento local.
NODE_ENV=development
PORT=3000
# Mesmo banco do docker compose da raiz
DATABASE_URL=postgresql://mony:mony-local@localhost:5432/mony
REDIS_URL=redis://localhost:6379
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
