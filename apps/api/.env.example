# Copie para .env e ajuste. Valores de exemplo, só para desenvolvimento local.
NODE_ENV=development
PORT=3000
# Mesmo banco do docker compose da raiz
DATABASE_URL=postgresql://mony:mony-local@localhost:5432/mony
REDIS_URL=redis://localhost:6379
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Chave privada ES256 dos tokens de acesso (PKCS#8 em PEM, uma linha com \n no lugar das quebras).
# Vazia em desenvolvimento: a API gera uma temporária a cada subida (os tokens caem ao reiniciar).
# Gerar: openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | awk 'NF {printf "%s\\n", $0}'
JWT_CHAVE_PRIVADA=
JWT_ID_CHAVE=mony-1
# E-mails transacionais: smtp (aqui, o Mailpit do docker compose: veja em http://localhost:8025),
# brevo (nuvem) ou fake (não envia; escreve o e-mail no log do worker).
EMAIL_PROVEDOR=smtp
SMTP_URL=smtp://localhost:1025
BREVO_CHAVE_API=
EMAIL_REMETENTE=nao-responda@mony.local
# Versão mínima do app (1.2.3). Abaixo dela, a API responde 426 e o app pede atualização.
APP_VERSAO_MINIMA_IOS=0.0.0
APP_VERSAO_MINIMA_ANDROID=0.0.0
# Arquivos no S3 local do docker compose (SeaweedFS). Na AWS: só S3_BUCKET e AWS_REGION.
S3_BUCKET=mony-local
S3_ENDPOINT=http://localhost:8333
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mony-local
AWS_SECRET_ACCESS_KEY=mony-local-segredo
