# Copie para .env e ajuste. Valores de exemplo, só para desenvolvimento local.
NODE_ENV=development
PORT=3000
# Mesmo banco do docker compose da raiz
DATABASE_URL=postgresql://mony:mony-local@localhost:5432/mony
REDIS_URL=redis://localhost:6379
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Chave privada ES256 dos tokens de acesso (PKCS#8 em PEM, uma linha com \n no lugar das quebras).
# Vazia em desenvolvimento: a API gera uma temporária a cada subida (os tokens caem ao reiniciar).
# Gerar: openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | awk 'NF {printf "%s\\n", $0}'
JWT_CHAVE_PRIVADA=
JWT_ID_CHAVE=mony-1
# E-mails transacionais: smtp (aqui, o Mailpit do docker compose: veja em http://localhost:8025),
# brevo (nuvem) ou fake (não envia; escreve o e-mail no log do worker).
EMAIL_PROVEDOR=smtp
SMTP_URL=smtp://localhost:1025
BREVO_CHAVE_API=
EMAIL_REMETENTE=nao-responda@mony.local
# Push: expo (nuvem) ou fake (não envia; escreve no log do worker). EXPO_ACCESS_TOKEN só com a
# segurança de push ligada no EAS.
PUSH_PROVEDOR=fake
EXPO_ACCESS_TOKEN=
# Modelo da Mony: anthropic (com ANTHROPIC_CHAVE_API) ou fake (responde um texto fixo, sem chamar
# ninguém).
IA_PROVEDOR=fake
ANTHROPIC_CHAVE_API=
IA_MODELO=claude-haiku-5-5
# Transcrição das mensagens de voz: deepgram (com DEEPGRAM_CHAVE_API) ou fake (texto fixo).
TRANSCRICAO_PROVEDOR=fake
DEEPGRAM_CHAVE_API=
TRANSCRICAO_MODELO=nova-3
# Cupom fiscal pelo QR Code: infosimples (com INFOSIMPLES_TOKEN) ou fake (cupom de exemplo).
NFCE_PROVEDOR=fake
INFOSIMPLES_TOKEN=
# Assinaturas: stripe (com a chave secreta de teste sk_test_… e o segredo do webhook whsec_…) ou
# fake (não cobra; o checkout devolve um endereço de mentira).
COBRANCA_PROVEDOR=fake
STRIPE_CHAVE_SECRETA=
STRIPE_SEGREDO_WEBHOOK=
# Endereço público da API: a Stripe devolve a pessoa para /v1/assinatura/retorno, que abre o app.
API_URL_PUBLICA=http://localhost:3000
# Versão mínima do app (1.2.3). Abaixo dela, a API responde 426 e o app pede atualização.
APP_VERSAO_MINIMA_IOS=0.0.0
APP_VERSAO_MINIMA_ANDROID=0.0.0
# Arquivos no S3 local do docker compose (SeaweedFS). Na AWS: só S3_BUCKET e AWS_REGION.
S3_BUCKET=mony-local
S3_ENDPOINT=http://localhost:8333
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mony-local
AWS_SECRET_ACCESS_KEY=mony-local-segredo
# Login social (RN-002): IDs de cliente OAuth separados por vírgula. Vazio desliga o provedor.
GOOGLE_CLIENT_IDS=
# Agenda do Google (T-085g): o cliente OAuth "Aplicativo da Web" do projeto no Google Cloud, com
# http://localhost:3000/v1/agendas/oauth/callback autorizado. Vazios: a agenda do Google é a falsa.
# A conta Google que conecta precisa estar em "Usuários de teste" enquanto o app não for verificado.
GOOGLE_OAUTH_ID_CLIENTE=
GOOGLE_OAUTH_SEGREDO=
APPLE_CLIENT_IDS=
# Alertas técnicos do worker (fila parada, falha em webhook, custo de IA), separados por vírgula.
# Vazio: só o log alerta_tecnico.
ALERTAS_TECNICOS_EMAILS=
# Namespace das métricas do worker no CloudWatch (na AWS, Mony/<ambiente>).
METRICAS_NAMESPACE=Mony/local
# Limite geral de requisições por IP por minuto (T-144a); 0 desliga.
LIMITE_REQUISICOES_IP_MINUTO=1200
# Sentry (T-142c): DSN do projeto (api ou worker). Vazio: Sentry desligado.
SENTRY_DSN=
# Ambiente no Sentry; vazio, o NODE_ENV. A release vem da imagem (Dockerfile).
SENTRY_AMBIENTE=

# Chave mestra (32 bytes em base64) da cifra dos tokens de agenda (doc 11). Vazia fora de produção:
# vale uma chave fixa de desenvolvimento. Gere com: openssl rand -base64 32
CRIPTO_CHAVE_MESTRA=
