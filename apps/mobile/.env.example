# Copie para .env (fica fora do Git). Só valores públicos: tudo aqui vai dentro do app.
# Ambiente: development, preview ou production (o EAS define pelo perfil do eas.json).
APP_ENV=development
# API local. Emulador Android: deixe localhost e rode `adb reverse tcp:3000 tcp:3000` e
# `adb reverse tcp:8333 tcp:8333` (README). Aparelho: http://<IP do computador>:3000.
EXPO_PUBLIC_API_URL=http://localhost:3000
# DSN do projeto "mobile" no Sentry. Vazio: Sentry desligado.
EXPO_PUBLIC_SENTRY_DSN=
# Número do app na App Store (sai na publicação). Vazio: a atualização obrigatória abre a busca.
EXPO_PUBLIC_APP_STORE_ID=
