# Copie para .env (fica fora do Git). Tudo que começa com VITE_ vai para o navegador: só valores públicos.
# Endereço da API. Vazio: o painel chama /v1 no próprio domínio (em desenvolvimento, o Vite repassa).
VITE_API_URL=
# Só desenvolvimento: para onde o Vite repassa /v1.
API_LOCAL=http://localhost:3000
# Sentry (T-142c): DSN do projeto "admin". Vazio: Sentry desligado.
VITE_SENTRY_DSN=
# Ambiente no Sentry; vazio, o modo do Vite (development ou production).
VITE_SENTRY_AMBIENTE=
